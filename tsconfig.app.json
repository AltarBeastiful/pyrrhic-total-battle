{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  // `scripts/plan-baseline-review.ts` is listed the way `tsconfig.node.json` lists
  // `tests/engine/plan-baseline.ts`, and for the mirror reason: the review report's own test renders it, so
  // the file has to be in this project's file list as well as in the node one that owns `scripts`.
  "include": ["src", "tests", "tools/theorycraft", "scripts/plan-baseline-review.ts"]
}
