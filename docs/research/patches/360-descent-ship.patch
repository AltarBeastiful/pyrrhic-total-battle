@@ -0,0 +1,291 @@
+/**
+ * **The descent from the flat shape** (owner, 2026-10-24; experiments 300 V3, 301, 353;
+ * `CAMPAIGN.planFixes.descent`). A candidate generator for the burn saver and the silver saver, read from the
+ * request and the stop alone — no history, so the same stop on the same account always gets the same answer.
+ *
+ * Seeds: every troop type on near-flat slots, in four orders (ranking, kill order, damage per leadership, HP per
+ * leadership) under two hired variants (the stop's own hired stacks, and the same with every dominance stack at
+ * one chunk), each laid at the largest slot HP that fits the leadership and stays within the stop's queue (a
+ * silver saver also its silver), then re-typed (`retypeMarch`, silver and queue held). Greedy descent: drop one
+ * troop type a step (re-laid flat, or its slot dropped keeping the shape), ranked on a cheap Tight reading (no
+ * restarts), at most `maxVisits` marches. The best `topK` are then read with the full Tight raise — the march
+ * the March opens on — and the best one that rates above the stop by more than `minRating`, burns no more,
+ * keeps `damageFloor` of its damage, trains no longer and (a silver saver) costs no more silver is the answer.
+ */
+import { RAISE_TIGHT, raiseKernel } from './fast';
+import { buildKillOrder } from './killOrder';
+import { effectiveTable, marchResult, rankTroops } from './plan';
+import type { Bill, MarkerRates } from './rating';
+import { rate } from './rating';
+import { chunks } from './recovery';
+import { marchBill, retypeMarch } from './retype';
+import type { StackRequest } from './types';
+
+/** The rule's numbers (`CAMPAIGN.planFixes.descent`). */
+export interface DescentRule {
+  /** Marches the descent reads at most (seeds included). */
+  maxVisits: number;
+  /** Candidates read with the full Tight raise. */
+  topK: number;
+}
+
+/** What the descent hands the plan: the march as the plan fields it (pre-raise) and its Tight reading. */
+export interface Descended {
+  counts: Record<string, number>;
+  bill: Bill;
+  /** Its rating against the stop's own Tight reading. */
+  rating: number;
+}
+
+/** 292's near-flat step between two slots. */
+const SPREAD = 0.0019;
+const TIGHT = { authority: RAISE_TIGHT, dominance: RAISE_TIGHT };
+
+const keyOf = (counts: Record<string, number>): string =>
+  JSON.stringify(Object.entries(counts).filter(([, v]) => v > 0).sort());
+
+/** The march as the March opens on it: raised by Tight (`restarts` 0: the cheap reading), and its bill. */
+export function tightBill(
+  request: StackRequest,
+  counts: Record<string, number>,
+  restarts?: number,
+): Bill {
+  const base = marchResult(request, counts).result;
+  const own: Record<string, number> = {};
+  for (const stack of base.stacks) own[stack.unitId] = stack.count;
+  const kernel = raiseKernel();
+  const fast =
+    kernel === null
+      ? null
+      : kernel.position({ request, base, modes: TIGHT, ...(restarts === undefined ? {} : { restarts }) });
+  const raised = fast !== null ? { ...own, ...fast.counts } : own;
+  const bill = marchBill(request, raised);
+  let hired = 0;
+  for (const stack of base.stacks) if (stack.pool === 'authority') hired += chunks(raised[stack.unitId] ?? 0);
+  return { ...bill, hired };
+}
+
+/** The bar's gates on a replacement, on Tight readings (290-common's `admissible`). */
+function admissible(pick: string, shipped: Bill, next: Bill, damageFloor: number): boolean {
+  if ((next.hired ?? 0) > (shipped.hired ?? 0)) return false;
+  if (next.damage < shipped.damage * damageFloor) return false;
+  if ((next.seconds ?? 0) > (shipped.seconds ?? 0) + 1e-6) return false;
+  if (pick === 'silver-saver' && (next.silver ?? 0) > (shipped.silver ?? 0) + 1e-6) return false;
+  return true;
+}
+
+/** How far outside the gates, in summed percent (0 inside): the descent's order among refused marches. */
+function outside(pick: string, shipped: Bill, next: Bill, damageFloor: number): number {
+  let v = 0;
+  const pct = (a: number, b: number): number => ((a - b) / Math.max(1, b)) * 100;
+  if ((next.hired ?? 0) > (shipped.hired ?? 0)) v += 100 * ((next.hired ?? 0) - (shipped.hired ?? 0));
+  if (next.damage < shipped.damage * damageFloor)
+    v += ((shipped.damage * damageFloor - next.damage) / shipped.damage) * 100;
+  if ((next.seconds ?? 0) > (shipped.seconds ?? 0) + 1e-6) v += pct(next.seconds ?? 0, shipped.seconds ?? 0);
+  if (pick === 'silver-saver' && (next.silver ?? 0) > (shipped.silver ?? 0) + 1e-6)
+    v += pct(next.silver ?? 0, shipped.silver ?? 0);
+  return v;
+}
+
+interface Node {
+  counts: Record<string, number>;
+  troops: { id: string; hp: number }[];
+  hired: Record<string, number>;
+  bill: Bill;
+  r: number;
+  adm: boolean;
+  v: number;
+}
+
+/**
+ * The descent's best march for one stop, or `null` when none rates above it by more than `minRating`.
+ * `pick` is the stop's kind (`silver-saver` holds its silver), `stopCounts` its repeated march.
+ */
+export function descend(
+  request: StackRequest,
+  pick: string,
+  stopCounts: Record<string, number>,
+  rates: MarkerRates,
+  rule: DescentRule & { minRating: number; damageFloor: number; tierCandidate?: boolean | undefined },
+): Descended | null {
+  if (raiseKernel() === null) return null;
+  const floor = rule.damageFloor;
+  const table = effectiveTable(request);
+  const lead = table.filter((e) => e.pool === 'leadership');
+  const byId = new Map(lead.map((e) => [e.id, e]));
+  const rankMap = new Map(rankTroops(table).map((e, i) => [e.id, i]));
+  const allIds = lead.map((e) => e.id);
+  const byRank = (ids: string[]): string[] =>
+    [...ids].sort((a, b) => (rankMap.get(a) ?? 99) - (rankMap.get(b) ?? 99));
+  const flat = (k: number): number[] => Array.from({ length: k }, (_, j) => 1 - SPREAD * j);
+  const stop = marchResult(request, stopCounts).result;
+  if (!stop.stacks.some((s) => s.pool === 'leadership' && s.count > 0)) return null;
+  const H0: Record<string, number> = {};
+  const Hf: Record<string, number> = {};
+  for (const s of stop.stacks)
+    if (s.pool !== 'leadership') {
+      H0[s.unitId] = s.count;
+      Hf[s.unitId] = s.pool === 'dominance' ? Math.min(s.count, 10) : s.count;
+    }
+  const stopBill = marchBill(request, stopCounts);
+  const silverCeiling = pick === 'silver-saver' ? stopBill.silver : undefined;
+  const secondsCeiling = stopBill.seconds;
+  const shipped = tightBill(request, stopCounts);
+  const shippedProxy = tightBill(request, stopCounts, 0);
+  const L = request.housing.leadership;
+
+  /** The types laid over a slot shape (weights, biggest first) at the largest H the leadership and caps allow. */
+  const lay = (hired: Record<string, number>, perm: string[], shape: number[]): Record<string, number> | null => {
+    const build = (H: number): { counts: Record<string, number>; used: number } => {
+      const counts: Record<string, number> = { ...hired };
+      let used = 0;
+      perm.forEach((id, i) => {
+        const t = byId.get(id);
+        if (t === undefined) return;
+        const c = Math.ceil((H * (shape[i] ?? 0)) / t.hp);
+        counts[id] = c;
+        used += c * t.cost;
+      });
+      return { counts, used };
+    };
+    let lo = 0;
+    let hi = 1e9;
+    for (let i = 0; i < 70; i += 1) {
+      const mid = (lo + hi) / 2;
+      if (build(mid).used <= L) lo = mid;
+      else hi = mid;
+    }
+    const over = (H: number): boolean => {
+      const bill = marchBill(request, build(H).counts);
+      return (
+        (bill.seconds ?? 0) > (secondsCeiling ?? Infinity) + 1e-6 ||
+        (silverCeiling !== undefined && (bill.silver ?? 0) > silverCeiling + 1e-6)
+      );
+    };
+    if (over(lo)) {
+      let a = 0;
+      let b = lo;
+      for (let i = 0; i < 24; i += 1) {
+        const mid = (a + b) / 2;
+        if (over(mid)) b = mid;
+        else a = mid;
+      }
+      lo = a;
+    }
+    const built = build(lo);
+    if (perm.some((id) => (built.counts[id] ?? 0) <= 0)) return null;
+    return built.counts;
+  };
+  const legal = (counts: Record<string, number>): boolean => {
+    const p = marchResult(request, counts).result.pools;
+    return (
+      p.leadership.used <= p.leadership.capacity &&
+      p.authority.used <= p.authority.capacity &&
+      p.dominance.used <= p.dominance.capacity
+    );
+  };
+
+  const seen = new Set<string>([keyOf(stopCounts)]);
+  const visited: Node[] = [];
+  const evaluate = (counts: Record<string, number> | null): Node | null => {
+    if (counts === null || visited.length >= rule.maxVisits) return null;
+    if (!legal(counts)) return null;
+    const found = retypeMarch(request, counts, rates, {
+      ...(rule.tierCandidate === true ? { tierCandidate: true } : {}),
+      silverCeiling,
+      secondsCeiling,
+    });
+    const next = found?.counts ?? counts;
+    const k = keyOf(next);
+    if (seen.has(k)) return null;
+    seen.add(k);
+    const bill = tightBill(request, next, 0);
+    const { result } = marchResult(request, next);
+    const hired: Record<string, number> = {};
+    for (const s of result.stacks) if (s.pool !== 'leadership') hired[s.unitId] = s.count;
+    const troops = result.stacks
+      .filter((s) => s.pool === 'leadership' && s.count > 0)
+      .map((s) => ({ id: s.unitId, hp: s.totalHp }))
+      .sort((a, b) => b.hp - a.hp);
+    const node: Node = {
+      counts: next,
+      troops,
+      hired,
+      bill,
+      r: rate(shippedProxy, bill, rates),
+      adm: admissible(pick, shippedProxy, bill, floor),
+      v: outside(pick, shippedProxy, bill, floor),
+    };
+    visited.push(node);
+    return node;
+  };
+  const better = (a: Node, b: Node): boolean =>
+    a.adm !== b.adm
+      ? a.adm
+      : a.adm
+        ? a.r > b.r + 1e-6
+        : a.v < b.v - 1e-9 || (Math.abs(a.v - b.v) <= 1e-9 && a.r > b.r + 1e-6);
+
+  const killRank = new Map(buildKillOrder(request.units, request.options).map((id, i) => [id, i]));
+  const by =
+    (f: (id: string) => number) =>
+    (ids: string[]): string[] =>
+      [...ids].sort((a, b) => f(a) - f(b));
+  const orders: ((ids: string[]) => string[])[] = [
+    byRank,
+    by((id) => killRank.get(id) ?? 99),
+    by((id) => {
+      const e = byId.get(id);
+      return e ? e.damagePerUnit / e.cost : 0;
+    }),
+    by((id) => {
+      const e = byId.get(id);
+      return e ? e.hp / e.cost : 0;
+    }),
+  ];
+  const seeds: Node[] = [];
+  for (const order of orders)
+    for (const hired of [Hf, H0]) {
+      const n = evaluate(lay(hired, order(allIds), flat(allIds.length)));
+      if (n) seeds.push(n);
+    }
+  if (seeds.length === 0) return null;
+  let cur = seeds.reduce((m, n) => (better(n, m) ? n : m));
+  while (visited.length < rule.maxVisits && cur.troops.length > 1) {
+    const kids: Node[] = [];
+    const ids = cur.troops.map((t) => t.id);
+    for (let i = 0; i < ids.length && visited.length < rule.maxVisits; i += 1) {
+      const rest = ids.filter((_, j) => j !== i);
+      const a = evaluate(lay(cur.hired, byRank(rest), flat(rest.length)));
+      if (a) kids.push(a);
+      const restHp = cur.troops.filter((_, j) => j !== i).map((t) => t.hp);
+      const mean = restHp.reduce((s, x) => s + x, 0) / restHp.length;
+      const b = evaluate(
+        lay(
+          cur.hired,
+          rest,
+          restHp.map((h) => h / mean),
+        ),
+      );
+      if (b) kids.push(b);
+    }
+    if (kids.length === 0) break;
+    const best = kids.reduce((m, n) => (better(n, m) ? n : m));
+    if (!better(best, cur)) break;
+    cur = best;
+  }
+
+  // The read: admissible on the cheap reading against the stop's full one, the best `topK` read in full.
+  const ranked = visited
+    .map((node) => ({ node, r0: rate(shipped, node.bill, rates) }))
+    .filter((row) => admissible(pick, shipped, row.node.bill, floor))
+    .sort((a, b) => b.r0 - a.r0);
+  let best: Descended | null = null;
+  for (const { node } of ranked.slice(0, rule.topK)) {
+    const bill = tightBill(request, node.counts);
+    if (!admissible(pick, shipped, bill, floor)) continue;
+    const rating = rate(shipped, bill, rates);
+    if (rating > (best?.rating ?? 0)) best = { counts: node.counts, bill, rating };
+  }
+  return best !== null && best.rating > rule.minRating ? best : null;
+}
