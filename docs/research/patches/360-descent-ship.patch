@@ -0,0 +1,115 @@
+/**
+ * **The descent from the flat shape** (`CampaignInput.descent`, `CAMPAIGN.planFixes.descent`; owner, 2026-10-24;
+ * `engine/descent.ts`, experiments 300 V3, 353, 360).
+ *
+ *  - On the owner's 2026-10-22 account at Leonidas ★0, ★1 and ★2, the burn saver of a lower star, played under a
+ *    higher star, rates no better than that star's own burn saver (the owner's rating on the march as the March
+ *    opens it, Tight): a star never makes the merc saver worse. Before the descent, ★1's burn saver was beaten by
+ *    ★0's march played at ★1.
+ *  - On every benchmark army, the bar with the descent against the same bar without: a stop that moved is a burn
+ *    saver or a silver saver and rates more than `minRating` above the stop it replaced on Tight, burns no more,
+ *    keeps `damageFloor` of its damage, trains no longer and (silver saver) costs no more silver; no stop is lost.
+ *  - The answer is a function of the request: planned twice, the bar is the same.
+ */
+import { readFileSync } from 'node:fs';
+
+import { describe, expect, test } from 'vitest';
+
+import { CAMPAIGN } from '@/config';
+import { tightBill } from '@/engine/descent';
+import type { CampaignInput, CampaignPlan } from '@/engine/plan';
+import { planCampaign } from '@/engine/plan';
+import { rate } from '@/engine/rating';
+import { parseImport } from '@/share/exportImport';
+import { buildPlanRequest } from '@/state/derive';
+import type { Profile } from '@/state/schema';
+
+import { HORIZON, commonScenarios, ownerProfile, ownerScenarios } from './plan-scenarios';
+
+const ACCOUNT = new URL('../fixtures/pyrrhic-my-account-2026-10-22.json', import.meta.url);
+const rule = CAMPAIGN.planFixes.ratedStops;
+
+function accountAt(star: number): CampaignInput {
+  const parsed = parseImport(readFileSync(ACCOUNT, 'utf8'));
+  if (parsed.kind !== 'profile') throw new Error('the fixture is not a profile');
+  const profile = structuredClone(parsed.payload) as Profile;
+  const leonidas = profile.sources.captains.find((c) => c.captainId === 'leonidas');
+  if (!leonidas) throw new Error('no Leonidas on the account');
+  leonidas.star = star;
+  const setup = profile.setups[0];
+  if (!setup) throw new Error('no setup');
+  return buildPlanRequest(profile, setup);
+}
+
+describe('the descent on the 2026-10-22 account', () => {
+  const inputs = [0, 1, 2].map(accountAt);
+  const plans = inputs.map((input) => planCampaign(input));
+  const burnSaver = (plan: CampaignPlan) => plan.alternatives.find((row) => row.pick === 'burn-saver');
+
+  test.each([
+    [0, 1],
+    [1, 2],
+    [0, 2],
+  ] as const)('the merc saver at ★%i played at ★%i rates no better than that star’s own', (a, b) => {
+    const low = burnSaver(plans[a] as CampaignPlan);
+    const high = burnSaver(plans[b] as CampaignPlan);
+    expect(low && high).toBeTruthy();
+    if (!low || !high) return;
+    const request = (inputs[b] as CampaignInput).request;
+    const played = tightBill(request, low.counts);
+    const own = tightBill(request, high.counts);
+    expect(rate(played, own, CAMPAIGN.markerRates)).toBeGreaterThanOrEqual(0);
+  });
+
+  test('planned twice, the bar is the same', () => {
+    const again = planCampaign(accountAt(1));
+    expect(again.alternatives.map((row) => row.counts)).toEqual(
+      (plans[1] as CampaignPlan).alternatives.map((row) => row.counts),
+    );
+  });
+}, 600_000);
+
+const profile = ownerProfile();
+const scenarios = [...commonScenarios(), ...(profile ? ownerScenarios(profile) : [])];
+
+const plan = (input: CampaignInput): CampaignPlan | undefined => {
+  try {
+    return planCampaign(input);
+  } catch {
+    return undefined;
+  }
+};
+
+describe('the descent on the benchmark armies', () => {
+  test.each(scenarios.map((s) => [s.label, s] as const))(
+    '%s',
+    (_label, scenario) => {
+      const base = {
+        request: scenario.request,
+        marchTarget: HORIZON,
+        ...CAMPAIGN.planFixes,
+        putBack: CAMPAIGN.putBack,
+      };
+      const off = plan({ ...base, descent: undefined });
+      const on = plan(base);
+      expect(off === undefined).toBe(on === undefined);
+      if (!off || !on) return;
+      expect(on.alternatives.map((row) => row.pick)).toEqual(off.alternatives.map((row) => row.pick));
+      for (const was of off.alternatives) {
+        const now = on.alternatives.find((row) => row.pick === was.pick);
+        if (!now || JSON.stringify(now.counts) === JSON.stringify(was.counts)) continue;
+        const tag = `${was.pick} moved`;
+        expect(['burn-saver', 'silver-saver'], tag).toContain(was.pick);
+        const before = tightBill(scenario.request, was.counts);
+        const after = tightBill(scenario.request, now.counts);
+        expect(rate(before, after, CAMPAIGN.markerRates), `${tag}: rating`).toBeGreaterThan(rule.minRating);
+        expect(after.hired ?? 0, `${tag}: burn`).toBeLessThanOrEqual(before.hired ?? 0);
+        expect(after.damage, `${tag}: damage floor`).toBeGreaterThanOrEqual(before.damage * rule.damageFloor);
+        expect(after.seconds ?? 0, `${tag}: queue`).toBeLessThanOrEqual((before.seconds ?? 0) + 1e-6);
+        if (was.pick === 'silver-saver')
+          expect(after.silver ?? 0, `${tag}: silver`).toBeLessThanOrEqual((before.silver ?? 0) + 1e-6);
+      }
+    },
+    600_000,
+  );
+});
