diff --git a/tools/theorycraft/360-descent-ship.test.ts b/tools/theorycraft/360-descent-ship.test.ts
new file mode 100644
index 0000000..96a052b
--- /dev/null
+++ b/tools/theorycraft/360-descent-ship.test.ts
@@ -0,0 +1,72 @@
+/**
+ * 360 — **shipping 300 V3's descent** (`src/engine/descent.ts`): parity of the engine port against 300/353's
+ * figures (the Tight bill through `marchBill` against 290-common's `applyCounts` reading, and the descent's rating
+ * per stop), then the plan with `descent` on against off, stop by stop, on the account at Leonidas ★0-★2 and on the
+ * benchmark armies.
+ *
+ * `THEORY=1 ACCT=<file> OUTF=<txt> [RUN=parity|acct|bench] pnpm vitest run tools/theorycraft/360-descent-ship.test.ts`
+ */
+/// <reference types="node" />
+import { appendFileSync, writeFileSync } from 'node:fs';
+import { describe, it } from 'vitest';
+
+import { descend, tightBill } from '../../src/engine/descent';
+import type { CampaignInput } from '../../src/engine/plan';
+import type { Bill } from '../../src/engine/rating';
+import { HORIZON, criteriaScenarios } from '../../tests/engine/plan-scenarios';
+import { CAMPAIGN, STOPS, accountInput, fullKernel, planCampaign, proxyKernel, rate, tight, useFull } from './290-common';
+
+const f = (b: Bill): string =>
+  `${(b.damage / 1e6).toFixed(3)}M s${(((b.silver ?? 0)) / 1e6).toFixed(3)}M g${Math.round(b.gold ?? 0)} h${String(b.hired)} c${Math.round(b.dragonCoins ?? 0)} q${Math.round(b.seconds ?? 0)}`;
+
+describe.skipIf(!process.env.THEORY)('360 — descent ship', () => {
+  it('runs', () => {
+    useFull();
+    const outf = process.env.OUTF!;
+    writeFileSync(outf, '');
+    const say = (s: string): void => appendFileSync(outf, s + '\n');
+    const run = process.env.RUN ?? 'parity';
+    const inputs: [string, CampaignInput][] =
+      run === 'bench'
+        ? criteriaScenarios().map((sc) => [sc.label, { request: sc.request, marchTarget: HORIZON, ...CAMPAIGN.planFixes, putBack: CAMPAIGN.putBack }] as [string, CampaignInput])
+        : [0, 1, 2].map((s) => [`acct ★${String(s)}`, accountInput(s)] as [string, CampaignInput]);
+    if (run !== 'parity') {
+      const pre = (r: { repeat: { damage: number; silver: number; gold: number; mercLost: number; dragonCoins?: number; seconds: number } }): Bill => ({ damage: r.repeat.damage, silver: r.repeat.silver, gold: r.repeat.gold, hired: r.repeat.mercLost, dragonCoins: r.repeat.dragonCoins ?? 0, seconds: r.repeat.seconds });
+      for (const [label, input0] of inputs) {
+        let off, on, msOff = 0, msOn = 0;
+        try {
+          let t = performance.now(); off = planCampaign({ ...input0, descent: undefined }); msOff = performance.now() - t;
+          t = performance.now(); on = planCampaign({ ...input0, descent: CAMPAIGN.planFixes.descent }); msOn = performance.now() - t;
+        } catch (e) { say(`${label} skipped ${String(e)}`); continue; }
+        say(`${label}: plan ${Math.round(msOff)} -> ${Math.round(msOn)} ms, stops ${String(off.alternatives.length)} -> ${String(on.alternatives.length)}`);
+        for (const was of off.alternatives) {
+          const now = on.alternatives.find((r) => r.pick === was.pick);
+          if (!now) { say(`  ${was.pick} LOST`); continue; }
+          if (JSON.stringify(now.counts) === JSON.stringify(was.counts) && now.totalDamage === was.totalDamage) continue;
+          const tw = tightBill(input0.request, was.counts), tn = tightBill(input0.request, now.counts);
+          say(`  ${was.pick} MOVED  tight ${f(tw)} -> ${f(tn)} rate ${rate(tw, tn, CAMPAIGN.markerRates).toFixed(2)}`);
+          say(`     pre-Tight repeat ${f(pre(was))} -> ${f(pre(now))} rate ${rate(pre(was), pre(now), CAMPAIGN.markerRates).toFixed(2)}`);
+          say(`     campaign dmg ${Math.round(was.totalDamage)} -> ${Math.round(now.totalDamage)} silver ${Math.round(was.silver)} -> ${Math.round(now.silver)} gold ${Math.round(was.gold)} -> ${Math.round(now.gold)} hired ${String(was.mercLost)} -> ${String(now.mercLost)} coins ${Math.round(was.dragonCoins)} -> ${Math.round(now.dragonCoins)} queue ${Math.round(was.seconds)} -> ${Math.round(now.seconds)}`);
+        }
+      }
+      return;
+    }
+    for (const [label, input0] of inputs) {
+      const input = { ...input0, descent: undefined } as CampaignInput;
+      let off;
+      try { off = planCampaign(input); } catch (e) { say(`${label} skipped ${String(e)}`); continue; }
+      for (const stop of off.alternatives) {
+        if (!STOPS.includes(stop.pick) || stop.sequence !== undefined || stop.pick === 'sweet-spot') continue;
+        const req = input.request;
+        if (run === 'parity') {
+          const a = tight(fullKernel, req, stop.counts).bill, b = tightBill(req, stop.counts);
+          const ap = tight(proxyKernel, req, stop.counts).bill, bp = tightBill(req, stop.counts, 0);
+          say(`${label} ${stop.pick} full ${f(a)} | ${f(b)} ${JSON.stringify(a) === JSON.stringify(b) ? 'SAME' : 'DIFF'}; proxy ${JSON.stringify(ap) === JSON.stringify(bp) ? 'SAME' : 'DIFF ' + f(ap) + ' | ' + f(bp)}`);
+        }
+        const t = performance.now();
+        const d = descend(req, stop.pick, stop.counts, CAMPAIGN.markerRates, { maxVisits: 60, topK: 6, minRating: -Infinity, damageFloor: 0.95, tierCandidate: true });
+        say(`${label} ${stop.pick} burn ${String(stop.repeat.mercLost)} descent rf ${d ? d.rating.toFixed(4) : '-'} ${d ? f(d.bill) : ''} ${Math.round(performance.now() - t)} ms`);
+      }
+    }
+  }, 86_400_000);
+});
diff --git a/tools/theorycraft/361-descent-pool.test.ts b/tools/theorycraft/361-descent-pool.test.ts
new file mode 100644
index 0000000..1dd1b64
--- /dev/null
+++ b/tools/theorycraft/361-descent-pool.test.ts
@@ -0,0 +1,150 @@
+/**
+ * 361 — **the descent's cost on a live Generate + advisor pass** (352's workload and pool replay, one kernel: the
+ * tree's, with the exact Tight package). Arms `off` (`descent` taken out of the plan input) and `on` (the shipped
+ * `CAMPAIGN.planFixes.descent`), run off → on → off → on; min of two per arm. Node has no web workers, so the pool
+ * runs inline and every `pool.map` batch is replayed on `WORKERS` workers (352/263). Answers are not compared:
+ * the descent moves stops, so the advisor reads different marches.
+ *
+ * `THEORY=1 ACCT=<file> [WORKERS=15] OUTF=<file> pnpm vitest run tools/theorycraft/361-descent-pool.test.ts`
+ */
+/// <reference types="node" />
+import { readFileSync, writeFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+
+import { planMarch, withMethod } from '../../src/engine';
+import { leadLineup } from '../../src/engine/captainUpgrades';
+import { setRaiseKernel, type RaiseKernel } from '../../src/engine/fast';
+import type { CampaignInput } from '../../src/engine/plan';
+import { genericProbes } from '../../src/engine/probes';
+import { loadKernelModule } from '../../tests/kernel/load';
+import { createRaiseKernel } from '../../src/kernel/raise';
+import { parseImport } from '../../src/share/exportImport';
+import { captainLineups } from '../../src/state/captainLineups';
+import { captainUpgradeCandidates } from '../../src/state/captainUpgrades';
+import { buildPlanRequest, buildStackRequest } from '../../src/state/derive';
+import type { Profile } from '../../src/state/schema';
+import { otherProbes } from '../../src/ui/sections/march/otherSearch';
+import { troopFloor } from '../../src/ui/sections/march/raise';
+import { openingPosition, pickOf } from '../../src/ui/sections/march/runStore';
+import { runAdvisor } from '../../src/worker/advisor';
+import { runCaptainAdvice } from '../../src/worker/captainAdvice';
+import { runCaptainUpgrades, type UpgradeAsk } from '../../src/worker/captainUpgrades';
+import { createInlineClient } from '../../src/worker/client';
+import { createCalcPool, type CalcPool, type PoolJob } from '../../src/worker/pool';
+
+const NO_CLOCK = 1_000_000_000;
+const WORKERS = Number(process.env.WORKERS ?? 15);
+const module = process.env.THEORY ? loadKernelModule() : null!;
+let descentOn = true;
+
+function makespan(durations: readonly number[], workers: number): number {
+  const free = Array.from({ length: Math.max(1, workers) }, () => 0);
+  for (const d of durations) {
+    let at = 0;
+    for (let i = 1; i < free.length; i += 1) if (free[i]! < free[at]!) at = i;
+    free[at]! += d;
+  }
+  return Math.max(0, ...free);
+}
+
+const answers: string[] = [];
+let tightMs = 0;
+function recording(inner: RaiseKernel): RaiseKernel {
+  return {
+    position(input) {
+      const t = performance.now();
+      const out = inner.position(input);
+      tightMs += performance.now() - t;
+      answers.push(JSON.stringify([out?.how ?? null, Object.entries(out?.counts ?? {}).filter(([, v]) => v !== 0).sort()]));
+      return out;
+    },
+  };
+}
+
+function timedPool(inner: CalcPool, batches: number[][]): CalcPool {
+  return {
+    get alive() { return inner.alive; },
+    get busy() { return inner.busy; },
+    dispose: () => inner.dispose(),
+    map: async (jobs, options) => {
+      const durations: number[] = [];
+      batches.push(durations);
+      const wrapped = jobs.map((job) => (async (client: Parameters<PoolJob<never>>[0], signal: Parameters<PoolJob<never>>[1]) => {
+        const at = performance.now();
+        try { return await (job as unknown as PoolJob<never>)(client, signal); } finally { durations.push(performance.now() - at); }
+      }) as PoolJob<never>);
+      return (await inner.map(wrapped as never, options as never)) as never;
+    },
+  };
+}
+
+async function runWorkload(profile: Profile, batches: number[][]): Promise<{ serial: number }> {
+  const setup = profile.setups.find((one) => one.id === profile.activeSetupId) ?? profile.setups[0]!;
+  const built: CampaignInput = buildPlanRequest(profile, setup);
+  const input: CampaignInput = { ...built, descent: descentOn ? built.descent : undefined };
+  const request = buildStackRequest(profile, setup);
+  const lane = () => ({ ...createInlineClient(), mode: 'worker' as const });
+  const client = lane();
+  const pool = timedPool(createCalcPool({ size: 1, createClient: lane }), batches);
+  let serial = 0;
+  try {
+    let t = performance.now();
+    const planned = await client.plan(input);
+    const chosen = pickOf(planned, openingPosition(planned, null));
+    const marchRequest = withMethod(request, 'elite');
+    if (troopFloor(planMarch(request, chosen.counts).result) !== null)
+      for (const row of planned.alternatives) await client.positions({ request: marchRequest, counts: row.counts });
+    serial += performance.now() - t;
+    const headline = chosen.pick;
+    await runAdvisor(input, genericProbes(), pool, { headline, budgetMs: NO_CLOCK });
+    const { currentKey, lineups, size } = captainLineups(profile, setup);
+    const advice = await runCaptainAdvice(input, lineups.map(({ key, totals }) => ({ key, totals })), currentKey, pool, { budgetMs: NO_CLOCK });
+    const lead = leadLineup(advice.best, currentKey);
+    const leadCandidate = lineups.find((trio) => trio.key === lead);
+    const leadStops = advice.plans[lead];
+    if (leadCandidate !== undefined && leadStops !== undefined) {
+      const asks: UpgradeAsk[] = captainUpgradeCandidates(profile, setup, leadCandidate, size).map((candidate) => ({
+        id: candidate.spec.id,
+        label: `${candidate.name} ${candidate.change}`,
+        lineups: candidate.lineups.map(({ key, totals }) => ({ key, totals })),
+      }));
+      await runCaptainUpgrades(input, { key: lead, totals: leadCandidate.totals, stops: leadStops }, asks, pool, { budgetMs: NO_CLOCK });
+    }
+    t = performance.now();
+    const { probes } = otherProbes(input, planned.silver);
+    serial += performance.now() - t;
+    await runAdvisor(input, probes, pool, { headline, budgetMs: NO_CLOCK });
+  } finally {
+    pool.dispose();
+    client.dispose();
+  }
+  return { serial };
+}
+
+describe.skipIf(!process.env.THEORY)('361 — descent on the pool', () => {
+  it('A/B', async () => {
+    const parsed = parseImport(readFileSync(process.env.ACCT ?? '', 'utf8'));
+    expect(parsed.kind).toBe('profile');
+    if (parsed.kind !== 'profile') return;
+    const runs: { arm: string; one: number; many: number; generate: number; tight: number; answers: string[] }[] = [];
+    for (const arm of ['off', 'on', 'off', 'on'] as const) {
+      descentOn = arm === 'on';
+      setRaiseKernel(recording(createRaiseKernel(module)));
+      answers.length = 0;
+      tightMs = 0;
+      const batches: number[][] = [];
+      const t = performance.now();
+      const { serial } = await runWorkload(structuredClone(parsed.payload) as Profile, batches);
+      const one = performance.now() - t;
+      const batchTime = batches.reduce((s, b) => s + b.reduce((a, c) => a + c, 0), 0);
+      const many = one - batchTime + batches.reduce((s, b) => s + makespan(b, WORKERS), 0);
+      runs.push({ arm, one, many, generate: serial, tight: tightMs, answers: [...answers] });
+    }
+    const min = (arm: string, k: 'one' | 'many' | 'generate' | 'tight') => Math.min(...runs.filter((r) => r.arm === arm).map((r) => r[k]));
+    const out = [
+      ...runs.map((r) => `${r.arm}: one worker ${r.one.toFixed(0)} ms, replayed on ${String(WORKERS)} workers ${r.many.toFixed(0)} ms, generate steps ${r.generate.toFixed(0)} ms, Σ Tight ${r.tight.toFixed(0)} ms, position() ${String(r.answers.length)}`),
+      ...(['many', 'one', 'generate', 'tight'] as const).map((k) => `min ${k}: off ${min('off', k).toFixed(0)} → on ${min('on', k).toFixed(0)} ms (×${(min('on', k) / min('off', k)).toFixed(2)})`),
+    ];
+    writeFileSync(process.env.OUTF ?? '/dev/stdout', out.join('\n') + '\n');
+  }, 7_200_000);
+});
