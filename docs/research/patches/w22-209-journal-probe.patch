+let actedB: usize = 0;
+let gDamage: f64 = 0.0;
+/** `attack()` over an explicit `acted` array: the cursor it leaves, the damage it found (0 when none) in `gDamage`. */
+@inline function attackIn(marks: usize, at: i32, k: i32): i32 {
+  let c = at;
+  gDamage = 0.0;
+  while (c < k) {
+    const index = i32At(attackers, c);
+    if (load<u8>(dead + <usize>index) == 0 && load<u8>(marks + <usize>index) == 0) {
+      store<u8>(marks + <usize>index, 1);
+      gDamage = f64At(stackDamage, index);
+      return c;
+    }
+    c += 1;
+  }
+  return c;
+}
+let bothMin: f64 = 0.0;
+let bothMax: f64 = 0.0;
+/** Both orientations of `journalDamage` in one walk: the kill sequence is shared, each total takes its own values in its own order. */
+function journalBoth(k: i32): void {
+  bothMin = 0.0;
+  bothMax = 0.0;
+  if (k <= 0 || enemySquads <= 0) return;
+  memory.fill(dead, 0, <usize>k);
+  memory.fill(acted, 0, <usize>k);
+  memory.fill(actedB, 0, <usize>k);
+  let cA = 0;
+  let cB = 0;
+  let lo: f64 = 0.0;
+  let hi: f64 = 0.0;
+  cB = attackIn(actedB, cB, k);
+  hi += gDamage;
+  let killed = 0;
+  while (killed < k) {
+    for (let e = 0; e < enemySquads && killed < k; e += 1) {
+      store<u8>(dead + <usize>killed, 1);
+      killed += 1;
+      if (e < enemySquads - 1 && killed < k) {
+        cA = attackIn(acted, cA, k);
+        lo += gDamage;
+        cB = attackIn(actedB, cB, k);
+        hi += gDamage;
+      }
+    }
+    for (let j = 0; j < k; j += 1) {
+      const index = i32At(attackers, j);
+      if (load<u8>(dead + <usize>index) == 0) {
+        const d = f64At(stackDamage, index);
+        if (load<u8>(acted + <usize>index) == 0) lo += d;
+        if (load<u8>(actedB + <usize>index) == 0) hi += d;
+      }
+    }
+    memory.fill(acted, 0, <usize>k);
+    memory.fill(actedB, 0, <usize>k);
+    cA = 0;
+    cB = 0;
+  }
+  bothMin = lo;
+  bothMax = hi;
+}
