+        const oneTo = f64At(rTo, one);
+        const otherTo = f64At(rTo, other);
+        let a = f64At(rFrom, one);
+        while (a <= oneTo) {
+          let b = f64At(rFrom, other);
+          while (b <= otherTo) {
+            raiseSet(i, one, a);
+            raiseSet(j, other, b);
+            const value = raisePointScore();
+            if (value > winnerScore) {
+              winnerOne = a;
+              winnerOther = b;
+              winnerScore = value;
+            }
+            b += 1.0;
+          }
+          a += 1.0;
+        }
+        raiseSet(i, one, winnerOne);
+        raiseSet(j, other, winnerOther);
+        if (winnerScore > best) {
+          best = winnerScore;
+          improved = true;
+          tick += 1;
+          if (winnerOne != startOne) store<i32>(dlChange + ((<usize>i) << 2), tick);
+          if (winnerOther != startOther) store<i32>(dlChange + ((<usize>j) << 2), tick);
+        }
+        store<i32>(pAt, tick);
+      }
+    }
+    if (!improved) return true;
+  }
+  return false;
+}
+
+/**
+ * EXPERIMENT 337 (algo 22): algo 20 plus **merged trajectories**. The pairwise descent is a deterministic map
+ * from the point a sweep starts at (with the sweeps left) to the point it converges to, so a sweep that starts
+ * where an earlier attempt's sweep started — and that earlier descent converged within as many sweeps as this
+ * one has left — ends where that one ended, which the search has already weighed (`rBest` takes strict
+ * improvements only). The attempt is abandoned there, climb included.
+ */
+const MT_BITS: i32 = 16;
+const MT_SIZE: i32 = 1 << MT_BITS;
+let mtKeys: usize = 0; // f64 x MT_SIZE
+let mtNeed: usize = 0; // i32 x MT_SIZE: sweeps that start needed to converge
+let mtGen: usize = 0; // i32 x MT_SIZE
+let mtCur: i32 = 0;
+let mtPend: usize = 0; // f64 x 64: this attempt's sweep-start keys
+let mtPendN: i32 = 0;
+let mtOn: bool = false;
+let xMerged: f64 = 0;
+export function xMergedCount(): f64 { return xMerged; }
+let mtStride: usize = 0;
+let mtStrideRoom: i32 = 0;
+function mtKey(): f64 {
+  let key: f64 = 0.0;
+  for (let s = 0; s < rN; s += 1) {
+    const t = i32At(rSlots, s);
+    key += (f64At(rPoint, t) - f64At(rFrom, t)) * f64At(mtStride, s);
+  }
+  return key;
+}
+function mtSlot(key: f64): i32 {
+  let h = <i32>((<u64>key * 0x9E3779B97F4A7C15) >> (64 - MT_BITS));
+  for (let probe = 0; probe < MT_SIZE; probe += 1) {
+    if (load<i32>(mtGen + ((<usize>h) << 2)) != mtCur) return h;
+    if (load<f64>(mtKeys + ((<usize>h) << 3)) == key) return h;
+    h = (h + 1) & (MT_SIZE - 1);
+  }
+  return -1;
+}
+function mtBegin(): void {
+  if (mtKeys == 0) {
+    mtKeys = heap.alloc((<usize>MT_SIZE) << 3);
+    mtNeed = heap.alloc((<usize>MT_SIZE) << 2);
+    mtGen = heap.alloc((<usize>MT_SIZE) << 2);
+    mtPend = heap.alloc(64 << 3);
+    for (let i = 0; i < MT_SIZE; i += 1) store<i32>(mtGen + ((<usize>i) << 2), 0);
+  }
+  if (rN > mtStrideRoom) { mtStride = heap.alloc((<usize>rN) << 3); mtStrideRoom = rN; }
+  let ks: f64 = 1.0;
+  for (let s = rN - 1; s >= 0; s -= 1) {
+    const t = i32At(rSlots, s);
+    store<f64>(mtStride + ((<usize>s) << 3), ks);
+    ks *= f64At(rTo, t) - f64At(rFrom, t) + 1.0;
+  }
+  mtOn = ks < 9007199254740992.0 && rSweeps <= 64;
+  mtCur += 1;
+  xMerged = 0;
+}
+/** 0 converged, 1 hit the sweep cap, 2 merged into an earlier attempt's descent. */
+function xPairwiseMT(): i32 {
+  if (rN * rN > dlRoom) {
+    dlRoom = rN * rN;
+    dlChange = heap.alloc((<usize>rN) << 2);
+    dlExam = heap.alloc((<usize>dlRoom) << 2);
+  }
+  for (let s = 0; s < rN; s += 1) store<i32>(dlChange + ((<usize>s) << 2), -1);
+  for (let p = 0; p < rN * rN; p += 1) store<i32>(dlExam + ((<usize>p) << 2), -2);
+  mtPendN = 0;
+  let tick: i32 = 0;
+  let best = raisePointScore();
+  for (let sweep = 0; sweep < rSweeps; sweep += 1) {
+    if (mtOn) {
+      const key = mtKey();
+      const h = mtSlot(key);
+      if (h >= 0 && load<i32>(mtGen + ((<usize>h) << 2)) == mtCur && load<i32>(mtNeed + ((<usize>h) << 2)) <= rSweeps - sweep) {
+        xMerged += 1.0;
+        return 2;
+      }
+      store<f64>(mtPend + ((<usize>sweep) << 3), key);
+      mtPendN = sweep + 1;
+    }
+    let improved = false;
+    for (let i = 0; i < rN; i += 1) {
+      for (let j = i + 1; j < rN; j += 1) {
+        const pAt = dlExam + ((<usize>(i * rN + j)) << 2);
+        const seen = load<i32>(pAt);
+        if (seen >= -1) {
+          let moved = false;
+          for (let k = 0; k < rN && !moved; k += 1) {
+            if (k == i || k == j) continue;
+            if (load<i32>(dlChange + ((<usize>k) << 2)) > seen) moved = true;
+          }
+          if (!moved) continue;
+        }
+        const one = i32At(rSlots, i);
+        const other = i32At(rSlots, j);
+        let winnerOne = f64At(rPoint, one);
+        let winnerOther = f64At(rPoint, other);
+        const startOne = winnerOne;
+        const startOther = winnerOther;
+        let winnerScore = best;
+        const oneTo = f64At(rTo, one);
+        const otherTo = f64At(rTo, other);
+        let a = f64At(rFrom, one);
+        while (a <= oneTo) {
+          let b = f64At(rFrom, other);
+          while (b <= otherTo) {
+            raiseSet(i, one, a);
+            raiseSet(j, other, b);
+            const value = raisePointScore();
+            if (value > winnerScore) {
+              winnerOne = a;
+              winnerOther = b;
+              winnerScore = value;
+            }
+            b += 1.0;
+          }
+          a += 1.0;
+        }
+        raiseSet(i, one, winnerOne);
+        raiseSet(j, other, winnerOther);
+        if (winnerScore > best) {
+          best = winnerScore;
+          improved = true;
+          tick += 1;
+          if (winnerOne != startOne) store<i32>(dlChange + ((<usize>i) << 2), tick);
+          if (winnerOther != startOther) store<i32>(dlChange + ((<usize>j) << 2), tick);
+        }
+        store<i32>(pAt, tick);
+      }
+    }
+    if (!improved) {
+      // Converged at sweep `sweep`: a start recorded at sweep q needed sweep - q + 1 sweeps.
+      if (mtOn) {
+        for (let q = 0; q < mtPendN; q += 1) {
+          const key = load<f64>(mtPend + ((<usize>q) << 3));
+          const h = mtSlot(key);
+          if (h < 0) continue;
+          const need = sweep - q + 1;
+          if (load<i32>(mtGen + ((<usize>h) << 2)) == mtCur && load<i32>(mtNeed + ((<usize>h) << 2)) <= need) continue;
+          store<f64>(mtKeys + ((<usize>h) << 3), key);
+          store<i32>(mtNeed + ((<usize>h) << 2), need);
+          store<i32>(mtGen + ((<usize>h) << 2), mtCur);
+        }
+      }
+      return 0;
+    }
+  }
+  return 1;
+}
