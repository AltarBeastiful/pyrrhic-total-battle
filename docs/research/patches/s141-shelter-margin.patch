+              );
+          }
+          for (const stop of b.stops)
+            if (!army.stops.some((s) => s.pick === stop.pick))
+              lines.push(`| ${army.label.slice(0, 44)} | ${short(stop.pick)} | disappears | | | | | | |`);
+          for (const reading of READINGS) {
+            const best = (stops: Stop[]): number =>
+              reading.high
+                ? Math.max(...stops.map((s) => reading.of(s.bill)))
+                : Math.min(...stops.map((s) => reading.of(s.bill)));
+            const va = best(b.stops);
+            const vb = best(army.stops);
+            const g = va === 0 ? 0 : ((reading.high ? vb - va : va - vb) / Math.abs(va)) * 100;
+            if (g < -1e-9)
+              worseReadings.push(`${army.label.slice(0, 44)}: ${reading.head} ${g.toFixed(3)} %`);
+          }
+        });
+        stopLines.set(m, lines);
+        const under2 = all.filter((v) => v < 0.02).length;
+        const under1 = all.filter((v) => v < 0.01).length;
+        summary.push(
+          `| ${pct(m)} | ${String(better)} / ${String(equal)} / ${String(worse)} | ` +
+            `${worst.r === Infinity || worst.r >= 0 ? '—' : `${sgn(worst.r)} (${worst.where})`} | ${String(worseReadings.length)} | ` +
+            `${String(ts.beaten)} / ${String(ts.out)} of ${String(ts.rows)} | ${String(broken)} | ` +
+            `${String(twin.pass)} pass / ${String(twin.fail)} fail / ${String(twin.inadmissible)} inadm. (${String(twin.marches)}) | ` +
+            `${pct(Math.min(...all))} | ${String(under1)} / ${String(under2)} of ${String(all.length)} |`,
+        );
+        readingLines.set(m, [...worseReadings, ...brokenList.map((b) => `criterion — ${b}`)]);
+      }
+      report.add(
+        '\n## Per margin, against margin 0\n\n| margin | stops better / equal / worse | worst | readings worse | ' +
+          'TotalStack matched spend (dominated / no fit) | armies breaking a criterion | tier twin | min margin on the bar | ' +
+          'marches under 1 % / under 2 % |\n|---|---|---|---:|---|---:|---|---:|---|\n' +
+          summary.join('\n') +
+          '\n',
+      );
+      for (const m of MARGINS) {
+        if (m === 0) {
+          const extra = readingLines.get(0) ?? [];
+          if (extra.length > 0) report.add(`\n**At margin 0**:\n\n- ${extra.join('\n- ')}\n`);
+          continue;
+        }
+        report.add(
+          `\n## Margin ${pct(m)} — every stop that moved\n\n| army | stop | rating | damage | silver | gold | hired | queue | margin |\n|---|---|---:|---|---|---|---|---|---|\n` +
+            ((stopLines.get(m) ?? []).join('\n') || '| (none) | | | | | | | | |') +
+            `\n\n**Readings worse, criteria broken**:\n\n- ${(readingLines.get(m) ?? []).join('\n- ') || 'none'}\n`,
+        );
+      }
+
+      // ---- the owner's two camps
+      for (const camp of [LIVE, MESSAGE]) {
+        const lines: string[] = [];
+        for (const m of [0, 0.02] as const) {
+          const army = (at.get(m) as Army[]).find((a) => a.label.startsWith(camp));
+          if (!army) continue;
+          for (const stop of army.stops)
+            lines.push(
+              `| ${pct(m)} | ${short(stop.pick)} | ${n(stop.bill.damage)} | ${n(stop.bill.silver)} | ${n(stop.bill.gold)} | ` +
+                `${String(stop.bill.hired)} | ${n(stop.bill.seconds / 3600)} h | ${stop.margin === null ? '—' : pct(stop.margin)} |`,
+            );
+        }
+        report.add(
+          `\n## ${camp}\n\n| margin | stop | damage | silver | gold | hired | queue | margin kept |\n|---|---|---:|---:|---:|---:|---:|---:|\n` +
+            lines.join('\n') +
+            '\n',
+        );
+      }
+      report.save();
+    });
+  },
+);
