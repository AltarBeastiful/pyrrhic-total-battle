+          if (row.damage > 0) theirs.push(row);
+        }
+        const ms =
+          theirs.length > 0
+            ? matchedSpend(priced as Contender[], theirs as Contender[])
+            : { rowsBeaten: 0, unfitted: 0 };
+        const army: Army = {
+          label: scenario.label,
+          stops,
+          criteria: criteria(request, rows, priced),
+          twin: {
+            marches: twin.marches,
+            pass: twin.pass,
+            fail: twin.fail,
+            inadmissible: twin.inadmissible.length,
+          },
+          ts: { rows: theirs.length, rowsBeaten: ms.rowsBeaten, unfitted: ms.unfitted },
+        };
+        if (head && headConfig) {
+          const was = head.planCampaign({
+            request,
+            marchTarget: HORIZON,
+            ...headConfig.CAMPAIGN.planFixes,
+            putBack: headConfig.CAMPAIGN.putBack,
+          });
+          army.identical = JSON.stringify(was.alternatives) === JSON.stringify(rows);
+        }
+        armies.push(army);
+      }
+      mkdirSync(DUMPS, { recursive: true });
+      writeFileSync(`${DUMPS}/margin-${String(margin)}.json`, JSON.stringify(armies, null, 1));
+    }, 14_400_000);
+  },
+);
+
+describe.skipIf(!process.env.THEORY || process.env.R173 === undefined)(
+  'a shelter margin — the report',
+  () => {
+    it('writes the report from the four dumps', () => {
+      const at = new Map<number, Army[]>(
+        MARGINS.map((m) => [
+          m,
+          JSON.parse(readFileSync(`${DUMPS}/margin-${String(m)}.json`, 'utf8')) as Army[],
+        ]),
+      );
+      const base = at.get(0) as Army[];
+      const pct = (v: number): string => `${(v * 100).toFixed(2)} %`;
+      const sgn = (v: number): string => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(3)}`;
+      const report = new Report('173-a-shelter-margin');
+      report.add('# 173 — a shelter margin\n');
+      report.add(
+        'Owner, 2026-09-24, shown marches sheltering their hired stacks at 1.00× the lowest troop stack: *"2 % seems ' +
+          'fair but could be configurable without clogging the ui, maybe hidden for now and conduct an experiment"*. ' +
+          '`CAMPAIGN.shelterMargin`: every hired stack strictly under `floor × (1 − margin)`, wherever the engine ' +
+          'decides or checks the shelter. Every benchmark army planned as the app plans it (`CAMPAIGN.planFixes`, the ' +
+          'put-back at the app’s rates), `budgetMs` off. Four-march campaigns priced by `campaignOf` (worst opening). ' +
+          'Stops paired by pick against margin 0; `rate(margin 0, margin m, markerRates)`: **better** > 0, **equal** 0, ' +
+          '**worse** < 0. Criteria are 169’s (the shelter read strictly). Margin of a march = `1 − hired top / troop ' +
+          'floor`.\n',
+      );
+      const identical = base.filter((a) => a.identical !== undefined);
+      report.add(
+        `\n**Margin 0 against HEAD (3c4b23d)**: ${String(identical.filter((a) => a.identical).length)} of ` +
+          `${String(identical.length)} armies byte-identical (\`JSON.stringify(plan.alternatives)\`)` +
+          (identical.some((a) => !a.identical)
+            ? ` — differ: ${identical
+                .filter((a) => !a.identical)
+                .map((a) => a.label)
+                .join('; ')}`
+            : '') +
+          '.\n',
+      );
+
+      // ---- the summary per margin
+      const summary: string[] = [];
+      const stopLines = new Map<number, string[]>();
+      const readingLines = new Map<number, string[]>();
+      for (const m of MARGINS) {
+        const armies = at.get(m) as Army[];
+        let better = 0;
+        let equal = 0;
+        let worse = 0;
+        let worst = { r: Infinity, where: '' };
+        const lines: string[] = [];
+        const worseReadings: string[] = [];
+        const ts = { rows: 0, beaten: 0, out: 0 };
+        let broken = 0;
+        const brokenList: string[] = [];
+        const twin = { marches: 0, pass: 0, fail: 0, inadmissible: 0 };
+        const all: number[] = [];
+        armies.forEach((army) => {
+          const b = base.find((x) => x.label === army.label);
+          ts.rows += army.ts.rows;
+          ts.beaten += army.ts.rowsBeaten;
+          ts.out += army.ts.unfitted;
+          if (army.criteria.length > 0) {
+            broken += 1;
+            brokenList.push(`${army.label.slice(0, 44)}: ${army.criteria.join(', ')}`);
+          }
+          twin.marches += army.twin.marches;
+          twin.pass += army.twin.pass;
+          twin.fail += army.twin.fail.length;
+          twin.inadmissible += army.twin.inadmissible;
+          for (const stop of army.stops) all.push(...stop.margins);
+          if (!b || b.stops.length === 0 || army.stops.length === 0) return;
+          for (const stop of army.stops) {
+            const was = b.stops.find((s) => s.pick === stop.pick);
+            if (!was) {
+              lines.push(`| ${army.label.slice(0, 44)} | ${short(stop.pick)} | appears | | | | | | |`);
+              continue;
+            }
+            const r = rate(was.bill, stop.bill, CAMPAIGN.markerRates);
+            const same = JSON.stringify(was.bill) === JSON.stringify(stop.bill);
+            if (same || Math.abs(r) < 1e-9) equal += 1;
+            else if (r > 0) better += 1;
+            else worse += 1;
+            if (!same && r < worst.r) worst = { r, where: `${army.label.slice(0, 44)} ${short(stop.pick)}` };
+            if (m !== 0 && !same)
+              lines.push(
+                `| ${army.label.slice(0, 44)} | ${short(stop.pick)} | ${sgn(r)} | ` +
+                  `${n(was.bill.damage)} → ${n(stop.bill.damage)} | ${n(was.bill.silver)} → ${n(stop.bill.silver)} | ` +
+                  `${n(was.bill.gold)} → ${n(stop.bill.gold)} | ${String(was.bill.hired)} → ${String(stop.bill.hired)} | ` +
+                  `${n(was.bill.seconds / 3600)} h → ${n(stop.bill.seconds / 3600)} h | ` +
