+
+const SCRATCH =
+  '/tmp/claude-1000/-home-remi-projects-pyrrhic-totalbattle/c483a563-ebd7-4335-848c-c63c59ca2333/scratchpad';
+const WT = process.env.WT173 ?? `${SCRATCH}/head`;
+const DUMPS = process.env.D173 ?? `${SCRATCH}/173`;
+const MARGINS = [0, 0.01, 0.02, 0.05] as const;
+const LIVE = 'the owner’s live camp of 2026-09-18';
+const MESSAGE = 'his camp of 2026-09-19, as his message reads it';
+
+const READINGS = [
+  { head: 'most damage', of: (c: StopBill) => c.damage, high: true },
+  { head: 'least silver', of: (c: StopBill) => c.silver, high: false },
+  { head: 'fewest hired lost', of: (c: StopBill) => c.hired, high: false },
+  { head: 'least gold', of: (c: StopBill) => c.gold, high: false },
+  { head: 'fewest coins', of: (c: StopBill) => c.dragonCoins, high: false },
+  { head: 'shortest queue', of: (c: StopBill) => c.seconds, high: false },
+  { head: 'dmg a silver', of: (c: StopBill) => (c.silver > 0 ? c.damage / c.silver : 0), high: true },
+  { head: 'dmg a merc', of: (c: StopBill) => c.hiredDamage / Math.max(1, c.hired), high: true },
+  { head: 'dmg a gold', of: (c: StopBill) => (c.gold > 0 ? c.damage / c.gold : 0), high: true },
+  { head: 'dmg a coin', of: (c: StopBill) => (c.dragonCoins > 0 ? c.damage / c.dragonCoins : 0), high: true },
+] as const;
+const SHORT: Record<string, string> = {
+  'burn-saver': 'HS',
+  'silver-saver': 'SS',
+  'sweet-spot': 'SW',
+  'more-mercs': 'MM',
+  'steady-max': 'MX',
+  'all-in': 'AI',
+};
+const short = (pick: string): string => SHORT[pick] ?? pick;
+
+interface StopBill extends Bill {
+  damage: number;
+  silver: number;
+  gold: number;
+  hired: number;
+  dragonCoins: number;
+  seconds: number;
+  hiredDamage: number;
+}
+interface Stop {
+  pick: string;
+  bill: StopBill;
+  /** The narrowest margin over the stop's marches that field a hired stack (1 − hired top / troop floor). */
+  margin: number | null;
+  /** Every distinct march's margin. */
+  margins: number[];
+}
+interface Army {
+  label: string;
+  refused?: boolean;
+  stops: Stop[];
+  criteria: string[];
+  twin: { marches: number; pass: number; fail: string[]; inadmissible: number };
+  ts: { rows: number; rowsBeaten: number; unfitted: number };
+  identical?: boolean;
+}
+
+/** `1 − hired top / troop floor` of one march, or `null` where it fields no hired stack. */
+const marginOf = (request: StackRequest, counts: Record<string, number>): number | null => {
+  const { result } = marchResult(request, counts);
+  const troops = result.stacks.filter((s) => s.pool === 'leadership' && s.count > 0);
+  const hired = result.stacks.filter((s) => s.pool !== 'leadership' && s.count > 0);
+  if (troops.length === 0 || hired.length === 0) return null;
+  const floor = Math.min(...troops.map((s) => s.totalHp));
+  return 1 - Math.max(...hired.map((s) => s.totalHp)) / floor;
+};
+
+const sheltered = (request: StackRequest, counts: Record<string, number>): boolean => {
+  const { result } = marchResult(request, counts);
+  const troops = result.stacks.filter((s) => s.pool === 'leadership');
+  if (troops.length === 0) return true;
+  const floor = Math.min(...troops.map((s) => s.totalHp));
+  return result.stacks.filter((s) => s.pool !== 'leadership').every((s) => s.totalHp < floor);
+};
+const sustained = (request: StackRequest, marches: Record<string, number>[]): boolean => {
+  const left: Record<string, number> = {};
+  for (const unit of request.units) {
+    if (unit.pool !== 'authority') continue;
+    const cap = request.caps[unit.id];
+    if (cap !== undefined) left[unit.id] = cap;
+  }
+  for (const march of marches) {
+    for (const [id, cap] of Object.entries(left)) {
+      const count = march[id] ?? 0;
+      if (count > cap) return false;
+      left[id] = cap - chunks(count);
+    }
+  }
+  return true;
+};
+/** 169's criteria, as they were read there. */
+const criteria = (request: StackRequest, rows: PlanRow[], priced: Campaign[]): string[] => {
+  const broken: string[] = [];
+  if (rows.length > 5) broken.push('more than five stops');
+  if (!rows.some((row) => row.pick === 'sweet-spot')) broken.push('no sweet spot');
+  const rungs = rows.filter((row) => row.pick !== 'all-in');
+  for (let i = 1; i < rungs.length; i += 1) {
+    const p = rungs[i - 1] as PlanRow;
+    const q = rungs[i] as PlanRow;
+    if (q.repeat.mercLost <= p.repeat.mercLost || q.repeat.damage <= p.repeat.damage)
+      broken.push(`order at ${short(q.pick)}`);
+  }
+  rows.forEach((x, i) => {
+    const cx = priced[i] as Campaign;
+    rows.forEach((y, k) => {
+      if (x === y || x.pick === 'all-in' || y.pick === 'all-in') return;
+      const cy = priced[k] as Campaign;
+      const dom =
+        cx.damage >= cy.damage &&
+        cx.silver <= cy.silver &&
+        cx.burned <= cy.burned &&
+        cx.gold <= cy.gold &&
+        (cx.damage > cy.damage || cx.silver < cy.silver || cx.burned < cy.burned || cx.gold < cy.gold);
+      if (dom) broken.push(`${short(x.pick)} beats ${short(y.pick)}`);
+    });
+    const marches = marchesOf(x as PlanTotals);
+    if (!marches.every((m) => sheltered(request, m))) broken.push(`${short(x.pick)} unsheltered`);
+    if (!sustained(request, marches)) broken.push(`${short(x.pick)} unsustained`);
+  });
+  return broken;
+};
+
+const scenarioList = () => {
+  const profile = ownerProfile();
+  return [...commonScenarios(), ...(profile ? ownerScenarios(profile) : [])];
+};
+
+type Planner = (input: Record<string, unknown>) => CampaignPlan;
+
+describe.skipIf(!process.env.THEORY || process.env.M173 === undefined)(
+  'a shelter margin — one margin planned',
+  () => {
+    it('plans every army at one margin and dumps it', async () => {
+      const margin = Number(process.env.M173);
+      const head =
+        margin === 0 && existsSync(`${WT}/src/engine/plan.ts`)
+          ? ((await import(`${WT}/src/engine/plan.ts`)) as { planCampaign: Planner })
+          : undefined;
+      const headConfig = head
+        ? ((await import(`${WT}/src/config.ts`)) as {
+            CAMPAIGN: { planFixes: Record<string, unknown>; putBack: unknown };
+          })
+        : undefined;
+      const armies: Army[] = [];
+      for (const scenario of scenarioList()) {
+        const request = scenario.request;
+        let plan: CampaignPlan;
+        try {
+          plan = planCampaign({
+            request,
+            marchTarget: HORIZON,
+            ...CAMPAIGN.planFixes,
+            shelterMargin: margin,
+            putBack: CAMPAIGN.putBack,
+          });
+        } catch {
+          armies.push({
+            label: scenario.label,
+            refused: true,
+            stops: [],
+            criteria: [],
+            twin: { marches: 0, pass: 0, fail: [], inadmissible: 0 },
+            ts: { rows: 0, rowsBeaten: 0, unfitted: 0 },
+          });
+          continue;
+        }
+        const rows = plan.alternatives;
+        const priced = rows.map((row) => campaignOf(request, row.pick, 'plan', marchesOf(row as PlanTotals)));
+        const stops: Stop[] = rows.map((row, i) => {
+          const c = priced[i] as Campaign;
+          const margins = [
+            ...new Set(marchesOf(row as PlanTotals).map((m) => JSON.stringify(Object.entries(m).sort()))),
+          ]
+            .map((key) => marginOf(request, Object.fromEntries(JSON.parse(key) as [string, number][])))
+            .filter((m): m is number => m !== null);
+          return {
+            pick: row.pick,
+            bill: {
+              damage: c.damage,
+              silver: c.silver,
+              gold: c.gold,
+              hired: c.burned,
+              dragonCoins: c.dragonCoins,
+              seconds: c.seconds,
+              hiredDamage: c.hiredDamage,
+            },
+            margin: margins.length > 0 ? Math.min(...margins) : null,
+            margins,
+          };
+        });
+        const twin = twinTest(request, scenario.label, rows, CAMPAIGN.markerRates);
+        const held = new Set(request.units.map((unit) => unit.id));
+        const theirs: Campaign[] = [];
+        for (const external of [...scenario.externals, ...totalstackRows(scenario.label)]) {
+          if (!external.name.startsWith('TotalStack')) continue;
+          if (Object.entries(external.counts).some(([id, c]) => c > 0 && !held.has(id))) continue;
