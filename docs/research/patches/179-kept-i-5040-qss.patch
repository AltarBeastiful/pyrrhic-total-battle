+  const out: { army: string; stop: string; role: string; gain: number }[] = [];
+  for (const line of md.split('\n')) {
+    if (!line.includes('| search: ') && !line.includes('the climb also stops short')) continue;
+    const cells = line.split('|').map((c) => c.trim());
+    const army = cells[1] ?? '';
