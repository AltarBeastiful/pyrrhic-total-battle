+const FIELDS: [keyof Figures, boolean][] = [
+  ['worst', true],
+  ['best', true],
+  ['silver', false],
+  ['gold', false],
+  ['hired', false],
+  ['coins', false],
+  ['seconds', false],
+  ['perSilver', true],
+  ['perGold', true],
+  ['perHired', true],
+  ['perCoin', true],
+];
+const worseOf = (o: Figures, s: Figures): string[] =>
+  FIELDS.filter(([k, high]) => (high ? s[k] < o[k] * (1 - 1e-12) : s[k] > o[k] * (1 + 1e-12))).map(
+    ([k]) => `${k} ${fmt(o[k], 3)} → ${fmt(s[k], 3)}`,
