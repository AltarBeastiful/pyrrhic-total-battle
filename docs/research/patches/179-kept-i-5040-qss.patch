index 0000000..d9a945a
--- /dev/null
+++ b/tests/engine/search-gap.test.ts
@@ -0,0 +1,249 @@
+/**
+ * **The re-typing search leaves nothing in its own space** (W14 step 4, `docs/plans/every-death-order.md` §3.4;
+ * experiments 175/176, "search — handed over, `retypeMarch` finds nothing" and "the climb also stops short").
+ *
+ * `retypeMarch` walks every assignment of the account's troop types to a march's troop slots when there are at
+ * most `EXHAUSTIVE` of them, and climbs by swap/replace above that. 176 measured the climb stopping short on 18
+ * marches (+5.19) and finding nothing where there was something on 8 (+2.62).
+ *
+ * The property, on every benchmark army (`plan-scenarios.ts`), planned as the app plans it (`CAMPAIGN.planFixes`,
+ * the put-back at the owner's rates) with `budgetMs` **off**: every march the re-typing pass handed to the search
+ * (`retypeOne`, read off `planTrace`) whose outcome **ships** (it is played by some stop) is not beaten, in the
+ * space the search walked (the handed march's own troop slots, its hired stacks kept to the unit), by an
+ * **admissible** assignment rating more than 0.01 above what the pass kept (175/176's tolerance). Admissible is what
+ * the pass itself would keep: the leadership fits, the worst-opening damage is held, the shelter is held where the
+ * march had it, and under the pass's own holds for that call (a silver saver's silver, damage per silver and queue;
+ * step 2). Marches the pass never sees (the band rows, a march handed back after the pass) are not in scope: no
+ * `retypeOne` outcome ships as them.
+ *
+ * **The oracle** is the exhaustive walk of that space in the kernel (`createKernel`'s batched `battleMany`), rated in
+ * JS by `rate` as the engine rates, whatever the path the plan ran on. The property is asserted where the space
+ * holds at most `ASSERT_CAP` = 5 040 assignments (seven types on seven slots: the owner's live accounts and camps).
+ * Up to `ORACLE_CAP` (eight of eight: the 4 000 case, his TotalStack profile, the Aydae setups) the oracle still
+ * runs and what the climb leaves there is printed, not asserted: walking those spaces costs the TypeScript fallback
+ * seconds (experiment 179). The first-run armies' 10 of 10 (3.6 × 10⁶ each) are counted only, to keep the test's
+ * runtime reasonable.
+ */
+import { describe, expect, it } from 'vitest';
+
+import { CAMPAIGN } from '../../src/config';
+import type { CampaignPlan, PlanTotals } from '../../src/engine/plan';
+import { planMarch } from '../../src/engine';
+import { effectiveTable, planCampaign } from '../../src/engine/plan';
+import type { PlanTraceEvent } from '../../src/engine/plan-trace';
+import { planTrace } from '../../src/engine/plan-trace';
+import type { Bill } from '../../src/engine/rating';
+import { rate } from '../../src/engine/rating';
+import type { StackRequest } from '../../src/engine/types';
+import { createKernel } from '../../src/kernel';
+import { R, RECORD_SIZE } from '../../src/kernel/layout';
+import { loadKernelModule } from '../kernel/load';
+import { HORIZON, commonScenarios, ownerProfile, ownerScenarios } from './plan-scenarios';
+
+const TOL = 0.01;
+/** Spaces the property is asserted on: every order of seven types on seven slots (`EXHAUSTIVE`'s 5 040). */
+const ASSERT_CAP = 5_040;
+/** Spaces the oracle still walks, to count what is left above `ASSERT_CAP` (eight types on eight slots). */
+const ORACLE_CAP = 50_000;
+const BATCH = 4_096;
+const RATES = CAMPAIGN.markerRates;
+const profile = ownerProfile();
+const scenarios = [...commonScenarios(), ...(profile ? ownerScenarios(profile) : [])];
+
+const keyOf = (counts: Record<string, number>): string =>
+  JSON.stringify(
+    Object.entries(counts)
+      .filter(([, c]) => c > 0)
+      .sort(),
+  );
+
+const played = (row: PlanTotals): { role: string; counts: Record<string, number> }[] => {
+  if (row.sequence) return row.sequence.map((counts, i) => ({ role: `sequence ${String(i + 1)}`, counts }));
+  const tail = row.tail?.marches ?? 0;
+  const repeats = row.marches - (row.finaleCounts ? 1 : 0) - tail;
+  const out: { role: string; counts: Record<string, number> }[] = [];
+  if (repeats > 0) out.push({ role: 'repeat', counts: row.counts });
+  if (row.finaleCounts) out.push({ role: 'finale', counts: row.finaleCounts });
+  if (row.tail && tail > 0) out.push({ role: 'tail', counts: row.tail.counts });
+  return out;
+};
+
+const billOf = (out: Float64Array, at: number): Bill => ({
+  damage: out[at + R.minDamage] as number,
+  silver: out[at + R.silver] as number,
+  gold: out[at + R.gold] as number,
+  hired: out[at + R.hired] as number,
+  dragonCoins: out[at + R.dragonCoins] as number,
+  seconds: out[at + R.seconds] as number,
+});
+
+type Retype = Extract<PlanTraceEvent, { step: 'retypeOne' }>;
+
+/**
+ * The best admissible rating in the space the search walked for `event`, by the kernel's exhaustive walk; `null`
+ * when the space is over `ORACLE_CAP`.
+ */
+const oracle = (
+  module: WebAssembly.Module,
+  request: StackRequest,
+  event: Retype,
+): { rating: number; space: number } | { rating: null; space: number } => {
+  const table = effectiveTable(request);
+  const lead = table.filter((entry) => entry.pool === 'leadership');
+  const { result } = planMarch(request, event.counts);
+  const troops = result.stacks.filter((s) => s.pool === 'leadership');
+  const slots = troops.map((s) => s.totalHp);
+  const k = slots.length;
+  const m = lead.length;
+  let space = 1;
+  for (let i = 0; i < k; i += 1) space *= m - i;
+  if (space > ORACLE_CAP) return { rating: null, space };
+  const kernel = createKernel(module, request, RATES);
+  const at = new Map(kernel.ids.map((id, i) => [id, i]));
+  const fixed = new Float64Array(kernel.types);
+  for (const s of result.stacks) if (s.pool !== 'leadership') fixed[at.get(s.unitId) as number] = s.count;
+  const leadAt = lead.map((entry) => at.get(entry.id) as number);
+  const base = billOf(kernel.battle(event.counts), 0);
+  const leadershipIds = new Set(lead.map((entry) => entry.id));
+  const shelterOf = (c: Float64Array): boolean => {
+    let floor = Infinity;
+    let hiredTop = 0;
+    for (const entry of table) {
+      const hp = (c[at.get(entry.id) as number] ?? 0) * entry.hp;
+      if (hp <= 0) continue;
+      if (leadershipIds.has(entry.id)) floor = Math.min(floor, hp);
+      else hiredTop = Math.max(hiredTop, hp);
+    }
+    return hiredTop < floor;
+  };
+  const baseCounts = new Float64Array(kernel.types);
+  for (const [id, c] of Object.entries(event.counts)) if (at.has(id)) baseCounts[at.get(id) as number] = c;
+  const shelteredBefore = shelterOf(baseCounts);
+  const admissible = (bill: Bill): boolean =>
+    bill.damage >= base.damage - 1e-6 &&
+    (!event.holdSilver ||
+      (bill.silver <= base.silver + 1e-6 && bill.damage * base.silver >= base.damage * bill.silver - 1e-6)) &&
+    (!event.holdQueue || bill.seconds <= base.seconds + 1e-6);
+
+  let best = 0;
+  const batch = new Float64Array(BATCH * kernel.types);
+  let filled = 0;
+  const flush = (): void => {
+    if (filled === 0) return;
+    const out = kernel.battleMany(batch.subarray(0, filled * kernel.types));
+    for (let i = 0; i < filled; i += 1) {
+      const bill = billOf(out, i * RECORD_SIZE);
+      if (!admissible(bill)) continue;
+      const r = rate(base, bill, RATES);
+      if (r <= best) continue;
+      const c = batch.subarray(i * kernel.types, (i + 1) * kernel.types);
+      if (shelteredBefore && !shelterOf(c)) continue;
+      best = r;
+    }
+    filled = 0;
+  };
+  const acc: number[] = [];
+  const used = new Array<boolean>(m).fill(false);
+  const walk = (): void => {
+    if (acc.length === k) {
+      let leadership = 0;
+      const row = batch.subarray(filled * kernel.types, (filled + 1) * kernel.types);
+      row.set(fixed);
+      acc.forEach((ti, slot) => {
+        const entry = lead[ti] as (typeof lead)[number];
+        const count = Math.ceil((slots[slot] as number) / entry.hp);
+        row[leadAt[ti] as number] = count;
+        leadership += count * entry.cost;
+      });
+      if (leadership > request.housing.leadership) return;
+      filled += 1;
+      if (filled === BATCH) flush();
+      return;
+    }
+    for (let i = 0; i < m; i += 1) {
+      if (used[i]) continue;
+      used[i] = true;
+      acc.push(i);
+      walk();
+      acc.pop();
+      used[i] = false;
+    }
+  };
+  walk();
+  flush();
+  return { rating: best, space };
+};
+
+const failures: string[] = [];
+let checked = 0;
+const beyond: string[] = [];
+/** Gaps in spaces over `ASSERT_CAP`, counted. */
+const leftOpen: string[] = [];
+
+describe('W14 step 4: the re-typing search leaves nothing in its own space', () => {
+  const module = loadKernelModule();
+  it.each(scenarios.map((s) => [s.label, s] as const))(
+    '%s',
+    (label, scenario) => {
+      const events: Retype[] = [];
+      planTrace.sink = (e) => {
+        if (e.step === 'retypeOne' && !e.deadline) events.push(e);
+      };
+      let plan: CampaignPlan;
+      try {
+        plan = planCampaign({
+          request: scenario.request,
+          marchTarget: HORIZON,
+          ...CAMPAIGN.planFixes,
+          putBack: CAMPAIGN.putBack,
+        });
+      } catch {
+        // An army the plan refuses has no bar to hold the test on (its refusal is pinned elsewhere).
+        return;
+      } finally {
+        planTrace.sink = null;
+      }
+      const shipped = new Map<string, string[]>();
+      for (const row of plan.alternatives)
+        for (const { role, counts } of played(row as PlanTotals)) {
+          const key = keyOf(counts);
+          shipped.set(key, [...(shipped.get(key) ?? []), `${row.pick} ${role}`]);
+        }
+      const fail: string[] = [];
+      const done = new Set<string>();
+      for (const event of events) {
+        const where = shipped.get(keyOf(event.out));
+        if (!where) continue;
+        const id = `${event.holdSilver ? 'held|' : ''}${event.holdQueue ? 'queue|' : ''}${keyOf(event.counts)}`;
+        if (done.has(id)) continue;
+        done.add(id);
+        const kept = event.found !== null && keyOf(event.out) === keyOf(event.found) ? event.rating : 0;
+        const o = oracle(module, scenario.request, event);
+        if (o.rating === null) {
+          beyond.push(`${label.slice(0, 44)} ${where.join('/')} (${String(o.space)})`);
+          continue;
+        }
+        const gap = `${label.slice(0, 44)} ${where.join('/')}: +${o.rating.toFixed(3)} in its space of ${String(o.space)}, the pass kept +${kept.toFixed(3)}`;
+        if (o.space > ASSERT_CAP) {
+          if (o.rating > kept + TOL) leftOpen.push(gap);
+          continue;
+        }
+        checked += 1;
+        if (o.rating > kept + TOL) fail.push(gap);
+      }
+      failures.push(...fail);
+      expect(fail, 'shipped marches an admissible assignment of their own space beats by more than 0.01').toEqual([]);
+    },
+    300_000,
+  );
+
+  it('over every army, no shipped re-typed march leaves more than 0.01 in its own space', () => {
+    // eslint-disable-next-line no-console
+    console.log(
+      `search gap: ${String(checked)} searches checked, ${String(failures.length)} fail; ` +
+        `${String(leftOpen.length)} left in spaces over ${String(ASSERT_CAP)} (counted): ${leftOpen.join('; ')}; ` +
+        `${String(beyond.length)} over the oracle's cap, counted: ${beyond.join('; ')}\n${failures.join('\n')}`,
+    );
+    expect(failures).toEqual([]);
+  });
+});
