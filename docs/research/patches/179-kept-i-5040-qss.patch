+    for (const which of (cells[3] ?? '').split(',').map((w) => w.trim())) {
+      const [stop, ...role] = which.split(' ');
+      out.push({ army, stop: stop ?? '', role: role.join(' '), gain });
+    }
+  }
+  return out;
+};
