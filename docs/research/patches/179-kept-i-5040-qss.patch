+/**
+ * 179 — **the search gap** (W14 step 4, `docs/plans/every-death-order.md` §3.4; experiments 175/176: the climb
+ * `retypeMarch` runs above `EXHAUSTIVE` stops short, and "handed over, finds nothing").
+ *
+ * Variants, each measured on every benchmark army with `budgetMs` off, on both paths:
+ *  - none: step 3's logic (`EXHAUSTIVE` = 5 000; the control, timed in the same process);
+ *  - (i) `EXHAUSTIVE` raised, so the walk covers every space up to a cap counted in **assignments** (a count, never a
+ *    clock, so both paths choose the same): 5 040 (seven types on seven slots), 20 160 (six of eight) and 50 000
+ *    (eight of eight); the first-run armies' 10 of 10 (3.6 × 10⁶) stay on the climb under every cap measured;
+ *  - (ii) the threshold kept and the climb made stronger: three more seeds (the account's kill order and ranking over
+ *    the march's slots, the tier order reversed) and second-order moves once the first-order ones stall (3-cycles of
+ *    slots, and chains: an unused type in, the displaced type moved to another slot);
+ *  - (i)+(ii), at 5 040 and at 50 000;
+ *  - "+qss": a silver saver that holds the bar's shortest queue re-types every march with its queue held from the
+ *    start (step 2's `holdQueue`, which only came after a row-level loss): the stronger search found a repeat
+ *    that raised the saver's queue while its finale lowered it, and the own-ladder finale (step 3) then replaced
+ *    that finale, so the bar's shortest queue was lost;
+ *  - "+q-HS" and "+q-all": step 2's queue retry extended to the burn saver, and to every stop (rejected; measured
+ *    to show why).
+ *
+ * §2's report, for the variant kept (`VARIANT179`, default `i-5040+qss`): every army, every stop, every march, every
+ * criterion, compared with step 3's state (`out/178-own-ladder-finale.json`) and HEAD before W14
+ * (`out/176-baseline.json`); better / equal / worse; every worse figure; the ten readings; the bar criteria; TotalStack
+ * at matched spend; which of 176's search-gap marches each variant picks up; plan time on both paths (best of
+ * `REPS179`); the full-criteria recap of every silver saver.
+ *
+ * `THEORY=1 npx vitest run --project ts tools/theorycraft/179-search-gap.test.ts`
+ *
+ * The variants are chosen through a temporary switch (`globalThis.__w14s4`) that is **not** in the shipped engine,
+ * which keeps `i-5040+qss` alone: apply `docs/research/patches/179-variants.patch` to `src/engine/retype.ts` and
+ * `src/engine/plan.ts` as step 4 ships them to reproduce the variant table. Without it every variant plans the
+ * shipped one. "+qh" holds the queue march by march on whichever stop holds the bar's shortest queue, "+qhHS" on
+ * the burn saver alone, "+cap" has `keepReadings` hand a stop back past the owner's registered bounds (all measured
+ * after the main run and rejected: they undo accepted trades elsewhere).
+ */
+/// <reference types="node" />
+import { readFileSync } from 'node:fs';
+
+import { describe, it } from 'vitest';
+
+import { CAMPAIGN } from '../../src/config';
+import { setKernel } from '../../src/engine/fast';
+import type { CampaignPlan } from '../../src/engine/plan';
+import { planCampaign } from '../../src/engine/plan';
+import { planTrace } from '../../src/engine/plan-trace';
+import type { PlanTraceEvent } from '../../src/engine/plan-trace';
+import { rate } from '../../src/engine/rating';
+import { createPlanKernel } from '../../src/kernel/plan';
+import { HORIZON, commonScenarios, ownerProfile, ownerScenarios } from '../../tests/engine/plan-scenarios';
+import { loadKernelModule } from '../../tests/kernel/load';
+import { OUT_DIR, Report } from './harness';
+import type { ArmyReport, Figures } from './plan-report';
+import {
+  RATES,
+  billOfFigures,
+  compareReports,
+  fmt,
+  loadJson,
+  renderBaseline,
+  renderComparison,
+  reportArmy,
+  saveJson,
+  short,
+} from './plan-report';
+
+const REPS = Number(process.env.REPS179 ?? 3);
+type Variant = { name: string; exhaustive: number; seeds: boolean; cycles: boolean; queueAll?: boolean; queueSavers?: boolean; queueSS?: boolean; queueHolder?: boolean; holderPicks?: string[]; readingCaps?: number[] };
+const ALL: Variant[] = [
+  { name: 'none', exhaustive: 5_000, seeds: false, cycles: false },
+  { name: 'i-5040', exhaustive: 5_040, seeds: false, cycles: false },
+  { name: 'i-20160', exhaustive: 20_160, seeds: false, cycles: false },
+  { name: 'i-50000', exhaustive: 50_000, seeds: false, cycles: false },
+  { name: 'ii', exhaustive: 5_000, seeds: true, cycles: true },
+  { name: 'i-5040+ii', exhaustive: 5_040, seeds: true, cycles: true },
+  { name: 'i-50000+ii', exhaustive: 50_000, seeds: true, cycles: true },
+  { name: 'none+qss', exhaustive: 5_000, seeds: false, cycles: false, queueSS: true },
+  { name: 'i-5040+qss', exhaustive: 5_040, seeds: false, cycles: false, queueSS: true },
+  { name: 'i-5040+ii+qss', exhaustive: 5_040, seeds: true, cycles: true, queueSS: true },
+  { name: 'i-50000+qss', exhaustive: 50_000, seeds: false, cycles: false, queueSS: true },
+  { name: 'i-5040+qss+q-HS', exhaustive: 5_040, seeds: false, cycles: false, queueSS: true, queueSavers: true },
+  // Measured after the main table (REPS179=1), reported in the .md's closing section.
+  { name: 'i-5040+qh', exhaustive: 5_040, seeds: false, cycles: false, queueHolder: true },
+  { name: 'i-50000+qh', exhaustive: 50_000, seeds: false, cycles: false, queueHolder: true },
