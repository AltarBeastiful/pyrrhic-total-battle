{
  "name": "pyrrhic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Client-side epic-monster stacking calculator for Total Battle.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "data:format": "node scripts/data-format.ts",
    "data:check": "node scripts/data-check.ts",
    "data:compare": "node tools/totalstack-sync/compare.ts",
    "icons": "node src/pwa/generate-icons.mjs",
    "e2e": "playwright test",
    "contrast": "node scripts/contrast-check.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "size": "size-limit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.6",
    "size-limit": "13.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "size-limit": [
    {
      "name": "first load js (app + game data)",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/data-*.js"
      ],
      "limit": "340 kB"
    },
    {
      "name": "on-demand js (all other chunks)",
      "path": [
        "dist/assets/*.js",
        "!dist/assets/index-*.js",
        "!dist/assets/data-*.js"
      ],
      "limit": "90 kB"
    },
    {
      "name": "css",
      "path": "dist/assets/*.css",
      "limit": "40 kB"
    }
  ]
}
